# Pulled from Bitwarden, from the "Brimbot Deploy" item: each secret is a
# custom field on it. Names only, so this file is safe to commit.
# KAMAL_REGISTRY_PASSWORD is the same GitHub token BookPocket deploys with.
SECRETS=$(kamal secrets fetch --adapter bitwarden --account rjlacount@gmail.com --from "Brimbot Deploy" KAMAL_REGISTRY_PASSWORD BOT_TOKEN OBSERVING_LATITUDE OBSERVING_LONGITUDE OBSERVING_ELEVATION)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
BOT_TOKEN=$(kamal secrets extract BOT_TOKEN ${SECRETS})
OBSERVING_LATITUDE=$(kamal secrets extract OBSERVING_LATITUDE ${SECRETS})
OBSERVING_LONGITUDE=$(kamal secrets extract OBSERVING_LONGITUDE ${SECRETS})
OBSERVING_ELEVATION=$(kamal secrets extract OBSERVING_ELEVATION ${SECRETS})
